# Copy to .env and fill in. .env is gitignored.
DB_HOST=localhost
# Host port published by Docker Compose for local tools like goose.
# Use 5433 if your machine already has Postgres on 5432.
DB_PORT=5432
DB_USER=recipe
DB_PASSWORD=changeme
DB_NAME=recipe
DB_SSLMODE=disable
HTTP_ADDR=:8080
HTTP_PORT=8080

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
ALLOWED_EMAILS=you@example.com,partner@example.com
# Required: random value at least 32 characters long.
SESSION_SECRET=
SESSION_COOKIE_NAME=recipe_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=720
FRONTEND_URL=/api/me
